# Copy to backend/.env for local development. Never commit the real file.
APP_ENV=development

# PostgreSQL 13+ with the btree_gist extension available (Neon, Render, Supabase all ship it).
# Local: `docker compose up -d db` (port 5434). postgres:// URLs are rewritten to the psycopg driver.
DATABASE_URL=postgresql+psycopg://reception:reception@localhost:5434/reception

# Agent brain: "gemini" (real model) or "rules" (deterministic reference policy; no key needed).
AGENT_BRAIN=gemini
# Google Gemini (server-side only). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_THINKING_LEVEL=minimal
AGENT_TEMPERATURE=0.3
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_ATTEMPTS=2
# Hard cap on model calls per rolling 24 h for this deployment (guards a free-tier key).
DAILY_MODEL_CALL_LIMIT=15
# Optional USD per million tokens, to fill model_calls.cost_usd. Leave unset on the free tier.
# MODEL_PRICE_IN_PER_MTOK=
# MODEL_PRICE_OUT_PER_MTOK=

# The business
BUSINESS_NAME=Larkspur Salon
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91
CURRENCY_WORD=rupees
MAX_FAILED_TURNS=2

# Browser origin(s) allowed by CORS, comma-separated. Production: your Vercel URL, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5174
# Optional: require this code (entered once in the browser) for every API call on a public demo.
DEMO_ACCESS_CODE=
CALLS_PER_HOUR_PER_CLIENT=30
TURNS_PER_MINUTE_PER_CALL=20
